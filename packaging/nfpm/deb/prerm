#!/bin/sh
# deb prerm — stop the service before the binary goes away (upgrade or
# removal). Do NOT mask or disable at remove time beyond what dpkg does:
# `dpkg -r` keeps conffiles, and the postinst on upgrade re-enables.
# A revoked/deleted machine's agent exits 0 on its own — that is the stop
# mechanism; this is only the package lifecycle hook.

set -e

if [ "$1" = "remove" ] || [ "$1" = "upgrade" ]; then
    if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
        # Record whether the agent was serving before this stop: the postinst
        # on upgrade restarts exactly what was running. A deliberately
        # stopped agent (revoked machine, operator stop) leaves no marker and
        # stays stopped.
        if systemctl is-active --quiet machd.service 2>/dev/null; then
            : > /run/machd.was-running
        fi
        systemctl stop machd.service || true
    fi
fi

