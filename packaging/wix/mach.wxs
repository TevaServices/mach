<?xml version="1.0" encoding="utf-8"?>
<!--
  mach.wxs — the Windows MSI for the mach agent (#43).

  Built by release.yml's msi job:
    wix build -arch x64|arm64 \
      -define Version=<tag version> -define MachExeSource=<staged mach.exe>

  What it does:
    - per-machine install of mach.exe into Program Files\mach\
    - registers the `machd` Task Scheduler job on install (refreshed on
      upgrade): ONLOGON trigger, run level HIGHEST, /RI 1 restart interval
      (see packaging/README.md's caveat on what /RI can honestly promise —
      the restart-on-failure-only contract lives in the agent's exit codes)
    - deletes the task on uninstall

  /TR quoting: the task's action must be the quoted path plus its argument
  ("C:\Program Files\mach\mach.exe" run). MSI Formatted strings escape a
  literal quote with a backslash (\"), and the deferred type-34 command line
  is resolved at script-write time (properties included), yielding
    /TR ""C:\Program Files\mach\mach.exe" run"
  which schtasks stores as the quoted command line.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="mach agent"
      Manufacturer="TevaServices"
      Version="$(var.Version)"
      UpgradeCode="97A3604A-39DA-4238-B138-1D054D701DBF"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="Main" Level="1">
      <ComponentGroupRef Id="MachComponents" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="mach" />
    </StandardDirectory>

    <!-- v4/v5 schema: a Directory takes no ComponentGroup child (WIX0005,
         hit by the v0.8.0 run — #49); and Package takes no Fragment child
         either (WIX0005 again, caught by the new wix-smoke job on this very
         PR — the guard already paying for itself). The legal v4/v5 shape:
         ComponentGroup as a DIRECT child of Package, its Component pointed
         at INSTALLFOLDER via the Directory attribute; the Feature's
         ComponentGroupRef needs nothing else. -->
    <ComponentGroup Id="MachComponents">
      <Component Directory="INSTALLFOLDER" Id="MachExe" Guid="*">
        <File Id="MachExeFile" Source="$(var.MachExeSource)" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Registration is native Windows Installer, no Util extension CAs
     (type 34: synchronous exe, deferred, system context). Rationale (#51):
     the Util pair died at CA-dll spawn (2717, no dll trace) on x64 and the
     Util CA cannot exist in the Arm64 package GitHub's runner can install
     (1633 rejects the package before any CA runs); type-34 resolves its
     command at script-write time, needs no CustomActionData and no dll.
     The /TR argument nests quotes directly (type-34 ExeCommand is not a
     Formatted string, so no backslash-quote escaping — the &quot; pair is
     the XML escape only): /TR receives
       "C:\Program Files\mach\mach.exe" run
     as ONE argument with the quoted path inside. -->
    <CustomAction
        Id="RegisterMachd"
        Execute="deferred"
        Impersonate="no"
        Return="check"
        Directory="System64Folder"
        ExeCommand="schtasks.exe /Create /F /TN machd /RL HIGHEST /SC ONLOGON /RI 1 /TR &quot;[(INSTALLFOLDER)mach.exe] run&quot;" />
    <CustomAction
        Id="UnregisterMachd"
        Execute="deferred"
        Impersonate="no"
        Return="check"
        Directory="System64Folder"
        ExeCommand="schtasks.exe /Delete /F /TN machd" />
    <InstallExecuteSequence>
      <!-- Fresh install and upgrade both (re)register the task; uninstall
           deletes it. A repair (REINSTALL) also refreshes it. -->
      <Custom Action="RegisterMachd" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="UnregisterMachd" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL" />
    </InstallExecuteSequence>
  </Package>
</Wix>