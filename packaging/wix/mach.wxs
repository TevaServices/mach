<?xml version="1.0" encoding="utf-8"?>
<!--
  mach.wxs — the Windows MSI for the mach agent (#43).

  Built by release.yml's msi job: wix build -arch x64|arm64
    -define Version=<tag version>  -define MachExeSource=<staged mach.exe>

  What it does:
    - per-machine install of mach.exe into Program Files\mach\
    - registers the `machd` Task Scheduler job at install (and refreshes it
      on upgrade): ONLOGON trigger, run level HIGHEST, restart every minute
      on failure — mirroring the Linux service contract (restart on
      failure; exit 0 means stop. schtasks /RI only fires on failure
      because the task's action exiting cleanly ends the task instance —
      see packaging/README.md for the honest caveat about schtasks
      restart semantics)
    - deletes the task on uninstall

  Validation is in release.yml's msi job: silent install, schtasks query,
  silent uninstall, task gone.

  Version note: MSI ProductVersion is numeric-only (major.minor.build);
  the mach semver (e.g. 0.6.5) maps cleanly. The mach binary itself stays
  internally stamped with the full version (AGENTS.md "one version string").
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="mach agent"
      Manufacturer="TevaServices"
      Version="$(var.Version)"
      UpgradeCode="97A3604A-39DA-4238-B138-1D054D701DBF"
      Scope="perMachine"
      Compressed="yes"
      Language="1033"
      Codepage="1252">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <!-- Feature with the whole product; no UI sequence (silent install only). -->
    <Feature Id="Main" Level="1">
      <ComponentGroupRef Id="MachComponents" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="mach">
        <ComponentGroup Id="MachComponents">
          <Component Id="MachExe" Guid="*">
            <File Id="MachExeFile" Source="$(var.MachExeSource)" KeyPath="yes" />
          </Component>
        </ComponentGroup>
      </Directory>
    </StandardDirectory>

    <!-- The installed path, visible to the custom actions (formatted). -->
    <Property Id="MACHEXE_PATH" Value="[(INSTALLFOLDER)mach.exe]" />

    <!-- schtasks argument: /TR needs the program path INTERNALLY quoted
         (a path with spaces is one program token). The XML attribute uses
         &quot; to put literal double quotes INSIDE the formatted value;
         schtasks then stores the quoted command line in the task. -->
    <Property Id="SCHTASKS_CREATE_ARGS"
              Value="/Create /F /TN machd /RL HIGHEST /SC ONLOGON /RI 1 /TR &quot;[(INSTALLFOLDER)mach.exe] run&quot;" />
    <Property Id="SCHTASKS_DELETE_ARGS" Value="/Delete /F /TN machd" />

    <!-- Deferred, no-impersonate: needs the machine-wide (HIGHEST) task
         registration; runs after file placement (After=InstallFiles). -->
    <CustomAction Id="RegisterMachdTask"
                  DllEntry="CAQuietExec"
                  Execute="deferred"
                  Return="check"
                  Impersonate="no" />
    <CustomAction Id="SetRegisterMachdTask"
                  Property="RegisterMachdTask"
                  Value="&quot;[SystemFolder]schtasks.exe&quot; [SCHTASKS_CREATE_ARGS]"
                  HideTarget="no" />
    <CustomAction Id="UnregisterMachdTask"
                  DllEntry="CAQuietExec"
                  Execute="deferred"
                  Return="ignore"
                  Impersonate="no" />
    <CustomAction Id="SetUnregisterMachdTask"
                  Property="UnregisterMachdTask"
                  Value="&quot;[SystemFolder]schtasks.exe&quot; [SCHTASKS_DELETE_ARGS]"
                  HideTarget="no" />

    <InstallExecuteSequence>
      <Custom Action="SetRegisterMachdTask" After="InstallFiles" Condition="NOT Installed" Condition2="NOT REMOVE" />
      <Custom Action="RegisterMachdTask" After="SetRegisterMachdTask" Condition="NOT Installed" />
      <Custom Action="SetUnregisterMachdTask" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL" />
      <Custom Action="UnregisterMachdTask" After="SetUnregisterMachdTask" Condition="REMOVE~=&quot;ALL" />
    </InstallExecuteSequence>
  </Package>
</Wix>